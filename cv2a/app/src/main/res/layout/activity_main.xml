<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1E1E"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".MainActivity">

    <!-- Nadpis -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hoď kostkou"
        android:textColor="#E8DCC8"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- Dvě kostky vedle sebe -->
    <LinearLayout
        android:id="@+id/llDice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvDice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚀"
            android:textColor="#E8DCC8"
            android:textSize="100sp" />

        <TextView
            android:id="@+id/tvDice2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="⚀"
            android:textColor="#E8DCC8"
            android:textSize="100sp" />

    </LinearLayout>

    <!-- Součet -->
    <TextView
        android:id="@+id/tvSum"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="Součet: 2"
        android:textColor="#E8DCC8"
        android:textSize="24sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnRoll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hodit"
        android:textColor="#1E1E1E"
        android:backgroundTint="#E8DCC8"
        android:textSize="24sp" />

    <!-- Počet hodů -->
    <TextView
        android:id="@+id/tvRollCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Počet hodů: 0"
        android:textColor="#CBBFAF"
        android:textSize="18sp" />

</LinearLayout>