<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    tools:context=".MainActivity">

    <!-- HLAVNÍ NADPIS -->
    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Objednávka bot"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- OTÁZKA -->
    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Jaké boty chcete objednat?"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/tvHeaderTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <RadioGroup
        android:id="@+id/rgShoes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/textView2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tvPrice"
        app:layout_constraintHorizontal_weight="1">

        <RadioButton
            android:id="@+id/rOn1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="On 1" />

        <RadioButton
            android:id="@+id/rOn2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="On 2" />

        <RadioButton
            android:id="@+id/rOn3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="On 3" />

    </RadioGroup>

    <!-- BOX S CENOU -->
    <TextView
        android:id="@+id/tvPrice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:gravity="center"
        android:text="Cena: 0 Kč"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:background="#FFF3E0"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="@id/rgShoes"
        app:layout_constraintBottom_toBottomOf="@id/rgShoes"
        app:layout_constraintStart_toEndOf="@id/rgShoes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1" />

    <!-- DOPLŇKY -->
    <CheckBox
        android:id="@+id/cbBootstraps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Tkaničky"
        app:layout_constraintTop_toBottomOf="@id/rgShoes"
        app:layout_constraintStart_toStartOf="parent" />

    <CheckBox
        android:id="@+id/cbSocks"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ponožky"
        app:layout_constraintTop_toTopOf="@id/cbBootstraps"
        app:layout_constraintStart_toEndOf="@id/cbBootstraps"
        app:layout_constraintEnd_toStartOf="@id/cbFoam" />

    <CheckBox
        android:id="@+id/cbFoam"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tlumení"
        app:layout_constraintTop_toTopOf="@id/cbBootstraps"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- TLAČÍTKO OBJEDNAT -->
    <Button
        android:id="@+id/btnOrder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="Objednat"
        app:layout_constraintTop_toBottomOf="@id/cbBootstraps"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>