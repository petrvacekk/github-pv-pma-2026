
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Outfit Builder"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#111111" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            android:text="Vytvoř si vlastní kombinaci."
            android:textSize="14sp"
            android:textColor="#777777" />

        <!-- Vrchní díl -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="01 / VRCHNÍ DÍL"
            android:textStyle="bold"
            android:textColor="#777777" />

        <TextView
            android:id="@+id/tvTop"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:gravity="center"
            android:background="#F5F5F5"
            android:text="Black Tee"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#111111" />

        <Button
            android:id="@+id/btnTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Změnit vrchní díl"
            android:textAllCaps="false" />

        <!-- Spodní díl -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="02 / SPODNÍ DÍL"
            android:textStyle="bold"
            android:textColor="#777777" />

        <TextView
            android:id="@+id/tvBottom"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:gravity="center"
            android:background="#F5F5F5"
            android:text="Black Denim"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#111111" />

        <Button
            android:id="@+id/btnBottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Změnit spodní díl"
            android:textAllCaps="false" />

        <!-- Boty -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="03 / BOTY"
            android:textStyle="bold"
            android:textColor="#777777" />

        <TextView
            android:id="@+id/tvShoes"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:gravity="center"
            android:background="#F5F5F5"
            android:text="White Sneakers"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#111111" />

        <Button
            android:id="@+id/btnShoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Změnit boty"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnSaveOutfit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="♡ Uložit outfit"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>
